{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for TrackHelm",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "dialog:default",
    "allow-load-track",
    "allow-play",
    "allow-pause",
    "allow-stop",
    "allow-seek",
    "allow-set-volume",
    "allow-get-playback-status"
  ]
}
