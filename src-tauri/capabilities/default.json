{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for TrackHelm",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "dialog:default",
    "window-state:default",
    "allow-load-track",
    "allow-preload-track",
    "allow-play",
    "allow-pause",
    "allow-stop",
    "allow-seek",
    "allow-set-volume",
    "allow-set-speed",
    "allow-set-pitch",
    "allow-set-eq",
    "allow-set-eq-bands",
    "allow-set-compressor",
    "allow-set-dual-compressor",
    "allow-set-regions",
    "allow-get-playback-status",
    "allow-read-dir",
    "allow-get-waveform-slice",
    "allow-get-raw-samples",
    "allow-get-cloud-folders",
    "allow-open-file-external",
    "allow-read-audio-metadata",
    "allow-save-audio-metadata",
    "allow-read-file-bytes",
    "allow-export-audio-file",
    "allow-save-playlist-file",
    "allow-load-playlist-file",
    "allow-broadcast-remote-state",
    "allow-list-midi-devices",
    "allow-connect-midi-device",
    "allow-scan-library-folder",
    "allow-check-files-exist"
  ]
}
